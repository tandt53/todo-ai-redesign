{
  "name": "todo-ai-redesign",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:web": "vitest run src/assistant/web",
    "test:all": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev:assistant": "node --experimental-strip-types src/assistant/api/server.ts",
    "dev:web": "vite --config src/assistant/web/vite.config.ts",
    "build:web": "vite build --config src/assistant/web/vite.config.ts",
    "preview:web": "vite preview --config src/assistant/web/vite.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:harness": "node --experimental-strip-types tests/harness/qa-test-server.ts",
    "test:mobile": "vitest run src/assistant/mobile"
  },
  "dependencies": {
    "@radix-ui/react-toggle": "^1.1.2",
    "lucide-react-native": "^1.31.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-native": "^0.87.0",
    "react-native-svg": "^15.15.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2",
    "supertest": "^7.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.0"
  }
}
