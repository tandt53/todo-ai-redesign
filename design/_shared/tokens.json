{
  "$meta": {
    "system": "todo-ai redesign — voice-first",
    "feature": "F-001",
    "themes": ["dark", "light"],
    "default_theme": "dark",
    "rule": "Every value an implementer uses comes from this file. Reviewer C4 fails hardcoded design values.",
    "contrast": "All text-on-background pairs verified WCAG 2.1 AA >= 4.5:1 — pair list in components.md §Contrast"
  },

  "color": {
    "dark": {
      "bg": { "base": "#0C0E16", "raised": "#161A28", "hairline": "#232741" },
      "text": { "primary": "#F2F4FA", "secondary": "#A9B0CC", "muted": "#8189A8", "onAccent": "#0C0E16" },
      "primary": "#9D8CFF",
      "primaryTint": "#1B1833",
      "secondary": "#A9B0CC",
      "voice": { "listening": "#3EE6D2", "listeningTint": "#0E2724", "thinking": "#9D8CFF", "thinkingTint": "#1B1833" },
      "danger": "#FF7A8A",
      "success": "#4ADE9E",
      "question": "#FFC24B",
      "questionTint": "#2A2113",
      "diff": { "add": "#4ADE9E", "addTint": "#10261C", "remove": "#FF7A8A", "removeTint": "#2C161A" },
      "focusRing": "#3EE6D2"
    },
    "light": {
      "bg": { "base": "#F6F7FB", "raised": "#FFFFFF", "hairline": "#E4E6F0" },
      "text": { "primary": "#191D33", "secondary": "#454C6E", "muted": "#5D6486", "onAccent": "#FFFFFF" },
      "primary": "#5646D6",
      "primaryTint": "#EAE7FB",
      "secondary": "#454C6E",
      "voice": { "listening": "#0A7473", "listeningTint": "#DFF2F1", "thinking": "#5646D6", "thinkingTint": "#EAE7FB" },
      "danger": "#C7223A",
      "success": "#0E7B4F",
      "question": "#8A5A00",
      "questionTint": "#F7EDD8",
      "diff": { "add": "#0E7B4F", "addTint": "#E3F4EA", "remove": "#C7223A", "removeTint": "#FBE7EA" },
      "focusRing": "#5646D6"
    }
  },

  "gradient": {
    "voice": {
      "stops": ["#3EE6D2", "#9D8CFF"],
      "angle_deg": 135,
      "scope": "voice surface ONLY: mic orb glow, listening band, thinking breath. Illegal anywhere else."
    }
  },

  "font": {
    "family": {
      "display": "'Space Grotesk', 'Be Vietnam Pro', sans-serif",
      "body": "'Be Vietnam Pro', system-ui, sans-serif"
    },
    "size": { "display": 34, "title": 22, "stateLabel": 17, "body": 15, "meta": 13, "label": 11 },
    "weight": { "display": 700, "title": 600, "body": 400, "emphasis": 600, "label": 700 },
    "lineHeight": { "display": 1.2, "title": 1.3, "body": 1.5, "meta": 1.4 },
    "letterSpacing": { "display": "-0.03em", "label": "0.06em" },
    "numeric": "tabular-nums",
    "note": "Body line-height 1.5 minimum — Vietnamese stacked diacritics (ề ệ ỗ) must never clip. label size 11 is uppercase NEW/EDITED markers only."
  },

  "spacing": { "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "xxl": 32, "gutter_mobile": 20, "gutter_web": 24 },

  "radius": { "sm": 8, "md": 14, "bubble": 18, "sheet": 20, "pill": 999, "orb": "50%", "taskRow": 0,
    "note": "taskRow 0 — tasks are flat rows, not cards (carried from v3). Bubbles/chips/sheets are the only rounded surfaces." },

  "shadow": {
    "raised": "0 8px 24px -8px rgba(4, 6, 16, 0.50)",
    "raisedLight": "0 8px 24px -10px rgba(25, 29, 51, 0.18)",
    "glowListening": "0 0 24px rgba(62, 230, 210, 0.35)",
    "glowThinking": "0 0 24px rgba(157, 140, 255, 0.35)",
    "note": "List rows carry NO shadow. Glow shadows are voice-surface only."
  },

  "motion": {
    "duration_ms": { "micro": 120, "standard": 200, "emphasis": 320, "celebrate": 600, "auroraBreath": 2400, "diffFlashHold": 1600, "diffFlashFade": 400 },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)"
    },
    "stateTransition": "crossfade at standard(200ms); listening→thinking slides the aurora violet-ward over emphasis(320ms)",
    "reducedMotion": "all animations collapse to 80ms opacity; end states (strikethrough, collapse, markers) kept; haptics kept",
    "rule": "animate transform/opacity only (compositor-safe, 60fps)"
  },

  "icon": { "set": "lucide", "stroke": 1.8, "cap": "round", "size": { "sm": 16, "md": 20, "lg": 24 }, "rule": "no emoji as UI icons" },

  "haptic": {
    "listenStart": "impact.light", "listenEnd": "impact.light x2",
    "applied": "notification.success", "error": "notification.warning",
    "undo": "impact.medium", "optionTap": "selection"
  }
}
