# ── The model that answers ────────────────────────────────────────────────────
# Nothing here has a default. The server refuses to start an AI turn without
# both AI_PROVIDER and AI_MODEL, deliberately: a fallback would run your traffic
# against a vendor you never chose, and it would look like a working system.

# Registered out of the box: anthropic · openai · openai-compatible
AI_PROVIDER=anthropic

# Verbatim, as that provider names it. Examples, not recommendations:
#   anthropic          claude-opus-5 · claude-sonnet-5 · claude-haiku-4-5-20251001
#   openai             gpt-4.1 · o4-mini
#   openai-compatible  qwen2.5:14b · llama3.3:70b · whatever your server serves
AI_MODEL=

# Read first; if unset, the vendor's conventional name is used instead
# (ANTHROPIC_API_KEY, OPENAI_API_KEY, …), so nothing has to be renamed.
AI_API_KEY=

# Point at a gateway, a proxy, or a local server. This is what lets one
# OpenAI-compatible adapter cover Ollama, vLLM, LM Studio, OpenRouter, Together
# and Groq without a line of code each — e.g. http://localhost:11434
AI_BASE_URL=

# Optional. Positive integer; a nonsense value is rejected rather than sent.
AI_MAX_TOKENS=

# ── Khi model hỏng, chậm, hoặc tốn quá ───────────────────────────────────────
# Model thứ hai để lui về khi model chính không trả lời được. Cấu hình, không
# tự suy ra: chọn hộ nhà cung cấp và giá cho người dùng vào đúng lúc tệ nhất là
# việc không nên làm. Đặt cả hai, hoặc không đặt gì.
AI_FALLBACK_PROVIDER=
AI_FALLBACK_MODEL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_BASE_URL=

# Trần chi tiêu, USD mỗi tài khoản mỗi ngày. Không đặt = không có trần.
# Không có mặc định: một cái trần không ai chọn thì hoặc cao đến vô dụng, hoặc
# thấp đến mức chặn người dùng thật.
AI_DAILY_USD_PER_USER=

# ── Nghe: chuyển giọng nói thành chữ (tuỳ chọn) ──────────────────────────────
# Không đặt gì = không có STT phía máy chủ; client vẫn dùng bộ nhận dạng của
# hệ điều hành. Đặt một nửa (chỉ provider hoặc chỉ model) là lỗi, không phải
# đoán mò. Đã đăng ký: openai · openai-compatible · deepgram
STT_PROVIDER=
STT_MODEL=
STT_API_KEY=
STT_BASE_URL=

# ── Nói: chuyển chữ thành giọng nói (tuỳ chọn) ───────────────────────────────
# Đã đăng ký: openai · openai-compatible · deepgram · elevenlabs
# ElevenLabs cần voice id — truyền `voice`, hoặc đặt extra.voice_id
TTS_PROVIDER=
TTS_MODEL=
TTS_API_KEY=
TTS_BASE_URL=

# ── Đo chi phí AI ─────────────────────────────────────────────────────────────
# USD trên MỘT TRIỆU token, khoá theo `provider/model`. Không có mặc định nào:
# một model không nằm trong bảng vẫn được ghi số token, nhưng cost để null —
# một số bị thiếu thì trung thực, một số bịa ra thì không.
#
# GET /usage?bucket=day|week|month|total&by=model|provider|user|none&from=&to=
#
# Sổ đo ghi 20 trường mỗi lượt gọi. Ngoài lượng và giá, nó ghi độ trễ (gộp lại
# thành p50/p95/max, không phải trung bình — trung bình giấu mất cái đuôi), số
# lần thử lại, có phải lui sang model dự phòng không, model đã gọi những tool
# nào, lý do bị từ chối, và độ dài câu người dùng nói. KHÔNG ghi nội dung câu
# nói: đây là sổ chi phí và độ tin cậy, không phải nhật ký hội thoại.
#
# Ba vai trò, ba đơn vị. Không vai trò nào tính bằng đơn vị của vai trò khác.
#   nghĩ  : input / output / cached_input  — USD trên MỘT TRIỆU token
#   nghe  : per_minute                     — USD một phút audio
#   nói   : per_million_chars              — USD trên MỘT TRIỆU ký tự
#
# AI_PRICES={"anthropic/claude-opus-5":{"input":5,"output":25,"cached_input":0.5},
#            "anthropic/claude-haiku-4-5":{"input":1,"output":5,"cached_input":0.1},
#            "openai-compatible/qwen2.5:14b":{"input":0,"output":0},
#            "deepgram/nova-3":{"per_minute":0.0043},
#            "elevenlabs/eleven_flash_v2_5":{"per_million_chars":100}}
AI_PRICES=

# ── The rest ──────────────────────────────────────────────────────────────────
PORT=4460
